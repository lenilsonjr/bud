// Copy to Config/BundleIdSecrets.xcconfig (gitignored) for local signed/device builds. Not needed for
// CI (the workflow writes this file from the BUNDLE_ID_PREFIX / APPLE_TEAM_ID secrets).
BUNDLE_ID_PREFIX = com.yourdomain
DEVELOPMENT_TEAM = ABCDE12345
// APP_SLUG is set in the tracked Config/BundleId.xcconfig — change it there.
